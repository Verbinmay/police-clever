# Telegram
BOT_TOKEN=                     # токен от @BotFather. Privacy Mode должен быть ВЫКЛЮЧЕН — иначе бот не увидит обычные сообщения в группе
WEBHOOK_BASE_URL=https://example.com   # публичный https-адрес, без пути
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=          # любая случайная строка — проверяется в заголовке X-Telegram-Bot-Api-Secret-Token
PORT=3000

# База данных
DATABASE_URL=postgresql://police:police@localhost:5432/police

# Админ-панель
ADMIN_BOOTSTRAP_USERNAME=      # логин первого суперадмин-аккаунта — создаётся один раз, при пустой таблице admin_accounts
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_SECRET=                # любая случайная строка, для подписи сессионной cookie
LOG_RETENTION_DAYS=30

# AI — оба ключа опциональны, но заполните хотя бы тот, который реально
# планируете использовать. Какой провайдер активен прямо сейчас — переключается
# в админке (вкладка "AI-конфиг" → провайдер), без передеплоя. baseURL/модель/
# цена за токен для каждого провайдера тоже редактируются там же.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
