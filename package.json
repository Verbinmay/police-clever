{
	"name": "police-clever",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Telegram-бот-персона для групповых чатов: AI-шутки + голосование за мьют, управление через веб-админку",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"start": "tsx --env-file-if-exists=.env src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"argon2": "^0.41.1",
		"env-var": "^7.5.0",
		"express": "^4.21.2",
		"openai": "^4.94.0",
		"pg": "^8.13.1",
		"telegraf": "^4.16.3",
		"typeorm": "^0.3.20"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"allowScripts": {
		"argon2@0.41.1": true,
		"esbuild@0.28.2": true
	}
}
